# === Market Sense OS Environment Variables ===

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Market Data Providers (at least one required) ---
# Twelve Data (primary)
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# Alpha Vantage (fallback)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Financial Modeling Prep (fallback)
FMP_API_KEY=your_fmp_api_key

# Finnhub (fallback)
FINNHUB_API_KEY=your_finnhub_api_key

# --- Macro Data ---
FRED_API_KEY=your_fred_api_key

# --- RSS / News Feeds (optional) ---
RSS_FEED_URL_1=https://rsshub.app/wallstreetcn/news
RSS_FEED_URL_2=https://rsshub.app/wallstreetcn/live

# --- TradingView (client-side, no key needed) ---
# TradingView widgets load from the web; no API key required.

# --- App Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Shanghai
